{
  "name": "scaffoldor",
  "version": "1.1.0",
  "description": "Scaffold new projects from GitHub or GitLab templates with a single command",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "scaffoldor": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup src/index.ts --format esm --watch",
    "typecheck": "tsc --noEmit",
    "check-types": "tsc --noEmit",
    "test": "bun run build && bun test",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "keywords": [
    "cli",
    "scaffold",
    "scaffolding",
    "template",
    "templates",
    "generator",
    "boilerplate",
    "starter",
    "starter-kit",
    "project-generator",
    "github",
    "gitlab",
    "nextjs",
    "hono",
    "elysia",
    "nestjs",
    "bun",
    "nodejs",
    "typescript",
    "developer-tools"
  ],
  "author": "Scaffoldor Contributors",
  "license": "Apache-2.0",
  "homepage": "https://scaffoldor.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itstheanurag/scaffoldor.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/itstheanurag/scaffoldor/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "commander": "^12.1.0",
    "fs-extra": "^11.2.0",
    "inquirer": "^12.3.2",
    "picocolors": "^1.1.1",
    "simple-git": "^3.27.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@repo/schema": "workspace:*",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
